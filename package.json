{
  "name": "@sovarto/sankey",
  "version": "0.1.2",
  "description": "Framework-independent Sankey diagram engine (layout, SVG geometry, label collisions) following SankeyMATIC's style",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovarto/sankey.git"
  },
  "homepage": "https://github.com/sovarto/sankey#readme",
  "bugs": "https://github.com/sovarto/sankey/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "sankey",
    "diagram",
    "svg",
    "d3",
    "sankeymatic"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
